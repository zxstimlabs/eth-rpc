# Redis for rate-limit counters (required; the server refuses to start without it).
# In Docker, deploy/compose.yaml sets this to the bundled Redis.
REDIS_URL=redis://localhost:6379
# Postgres for credit balances, API key hashes and recorded payments (required;
# migrations run at startup). In Docker, deploy.sh generates it into db.env.
DATABASE_URL=postgres://zxstim:password@localhost:5432/zxstim_rpc
# Mainnets
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
# Testnets
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
